---
import { withBase } from '../utils/url';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const nav = [
  { href: withBase(''), label: '홈' },
  { href: withBase('services/'), label: '자문 서비스' },
  { href: withBase('about/'), label: '소개' },
  { href: withBase('blog/'), label: '학습 노트' },
  { href: withBase('contact/'), label: '문의' },
];
const path = new URL(Astro.request.url).pathname;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <meta name="description" content={description} />
  <title>{title} · 반도체 컨설팅</title>
</head>
<body>
  <a class="skip-link" href="#main">본문 바로가기</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href={withBase('')}>
        <span class="brand-mark" aria-hidden="true"></span>
        반도체 컨설팅
      </a>
      <nav aria-label="주요 메뉴">
        <ul class="nav-list">
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <p>© {new Date().getFullYear()} 반도체 컨설팅. All rights reserved.</p>
      <p class="footer-note">공정·소자·수율 자문 및 학습 콘텐츠 · 1인 운영</p>
    </div>
  </footer>

  <style is:global>
    :root {
      --bg: #0a0e17;
      --bg-elev: #10141f;
      --card: #141a29;
      --card-border: #232c42;
      --text: #e8ecf4;
      --text-dim: #93a0b8;
      --text-faint: #5f6b85;
      --accent: #3fd0ff;
      --accent-2: #8b7bff;
      --accent-soft: rgba(63, 208, 255, 0.12);
      --success: #4ade80;
      --radius: 14px;
      --radius-sm: 8px;
      --maxw: 1080px;
      color-scheme: dark;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background:
        radial-gradient(1200px 600px at 15% -10%, rgba(63, 208, 255, 0.08), transparent 60%),
        radial-gradient(900px 500px at 100% 0%, rgba(139, 123, 255, 0.08), transparent 55%),
        var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, 'Pretendard', 'Noto Sans KR', 'Malgun Gothic', sans-serif;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      background: var(--accent);
      color: #051019;
      padding: 10px 16px;
      border-radius: var(--radius-sm);
      z-index: 1000;
    }
    .skip-link:focus { left: 12px; top: 12px; }

    .wrap {
      max-width: var(--maxw);
      margin: 0 auto;
      padding: 0 20px;
    }

    a { color: inherit; text-decoration: none; }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(10, 14, 23, 0.85);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--card-border);
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 20px;
      flex-wrap: wrap;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 700;
      font-size: 17px;
      letter-spacing: -0.2px;
      white-space: nowrap;
    }
    .brand-mark {
      width: 20px;
      height: 20px;
      border-radius: 5px;
      background: conic-gradient(from 210deg, var(--accent), var(--accent-2), var(--accent));
      box-shadow: 0 0 14px rgba(63, 208, 255, 0.5);
      flex-shrink: 0;
    }
    .nav-list {
      list-style: none;
      display: flex;
      gap: 4px;
      margin: 0;
      padding: 0;
      flex-wrap: wrap;
    }
    .nav-list a {
      display: inline-block;
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      font-size: 14px;
      font-weight: 500;
      color: var(--text-dim);
      transition: color 0.15s, background 0.15s;
    }
    .nav-list a:hover { color: var(--text); background: rgba(255, 255, 255, 0.04); }
    .nav-list a[aria-current='page'] { color: var(--accent); background: var(--accent-soft); }

    main { display: block; }

    .site-footer {
      border-top: 1px solid var(--card-border);
      margin-top: 80px;
      padding: 28px 0 40px;
      color: var(--text-faint);
      font-size: 13px;
    }
    .footer-inner { display: flex; flex-direction: column; gap: 4px; }

    h1, h2, h3 { letter-spacing: -0.3px; line-height: 1.3; }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 22px;
      border-radius: 999px;
      font-weight: 600;
      font-size: 15px;
      border: 1px solid transparent;
      transition: transform 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .btn-primary {
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      color: #051019;
    }
    .btn-primary:hover { box-shadow: 0 8px 24px rgba(63, 208, 255, 0.25); transform: translateY(-1px); }
    .btn-ghost {
      border-color: var(--card-border);
      color: var(--text);
      background: rgba(255, 255, 255, 0.02);
    }
    .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

    .section {
      padding: 64px 0;
    }
    .section-head { max-width: 640px; margin-bottom: 36px; }
    .eyebrow {
      display: inline-block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 10px;
    }
    .section-head h2 { font-size: 28px; margin: 0 0 10px; }
    .section-head p { color: var(--text-dim); margin: 0; }

    .card {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: var(--radius);
      padding: 24px;
    }

    @media (max-width: 640px) {
      .section { padding: 44px 0; }
      .section-head h2 { font-size: 23px; }
    }
  </style>
</body>
</html>
